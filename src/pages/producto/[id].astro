---
/**
 * src/pages/producto/[id].astro
 * ============================================================================
 * Ficha de Producto Individual - StackLab Atelier (Zen Luxury E-Commerce)
 * ----------------------------------------------------------------------------
 * Esta página dinámica aprovecha la Generación de Sitios Estáticos (SSG) de Astro 5.
 * Renderiza una vista editorial de 2 columnas para cada objeto artesanal del catálogo.
 * ============================================================================
 */
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import DockBar from '../../components/DockBar.astro';
import { productRepository } from '../../data/repositories/product.repository';
import type { Product } from '../../data/products';
import { formatPrice } from '../../lib/stripe';

/**
 * getStaticPaths():
 * Genera en tiempo de compilación (build time) las rutas HTML estáticas para
 * cada producto provisto por el repositorio (/producto/prod-cypress-console, etc.).
 */
export async function getStaticPaths() {
  const allProducts = await productRepository.getAll();
  return allProducts.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

// Extracción de las propiedades del producto inyectadas por getStaticPaths()
const { product } = Astro.props;

// Redirección de seguridad a la página 404 si el objeto no existe
if (!product) {
  return Astro.redirect('/404');
}

/**
 * Curaduría de "Piezas en Resonancia":
 * Filtra el catálogo provisto por el repositorio para mostrar hasta 3 artículos relacionados, excluyendo el actual.
 */
const allCatalog = await productRepository.getAll();
const relatedProducts = allCatalog.filter((p) => p.id !== product.id).slice(0, 3);
---

<Layout 
  title={`${product.name} // StackLab Atelier`}
  description={product.description}
>
  <!-- Navigation Header -->
  <Navigation />

  <main class="relative min-h-screen bg-[#FBFBFA] pt-28 sm:pt-36 pb-20 sm:pb-28 overflow-hidden">
    <!-- Ambient Botanical Mist Glow -->
    <div class="absolute w-[600px] h-[600px] rounded-full bg-[#DCE3DA]/35 blur-[140px] -top-24 -left-24 pointer-events-none -z-10"></div>
    <div class="absolute w-[550px] h-[550px] rounded-full bg-[#EAE6DF]/60 blur-[130px] top-1/2 -right-24 pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-sans text-neutral-400 mb-8 sm:mb-12" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-[#243026] transition-colors">Inicio</a>
        <span>/</span>
        <a href="/#collection" class="hover:text-[#243026] transition-colors">Colección Permanente</a>
        <span>/</span>
        <span class="text-[#243026] font-medium">{product.name}</span>
      </nav>

      <!-- Main Product Stage (2-Column Luxury Editorial Grid) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        
        <!-- Left Column: Sticky High-Resolution Visual Presentation -->
        <div class="lg:col-span-7 lg:sticky lg:top-28 space-y-6">
          <div class="relative w-full aspect-[4/3] sm:aspect-[16/11] rounded-[28px] overflow-hidden bg-[#F5F3EF] border border-[#EBE7DF] shadow-zen-card group">
            <img 
              id="main-product-image"
              src={product.image} 
              alt={product.name} 
              class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105 filter brightness-[0.98]"
              loading="eager"
            />
            
            <!-- Category Badge -->
            <div class="absolute top-5 left-5">
              <span class="zen-badge bg-white/90 backdrop-blur-md text-[10px] text-[#243026]">
                ATELIER // {product.category}
              </span>
            </div>

            <!-- In-Stock Status Pill -->
            <div class="absolute top-5 right-5">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#243026]/85 text-white text-[10px] font-sans font-medium backdrop-blur-md">
                <span class="w-1.5 h-1.5 rounded-full bg-[#8A9A86] animate-pulse"></span>
                <span>{product.inStock ? 'Pieza en Taller' : 'Bajo Demanda'}</span>
              </span>
            </div>
          </div>

          <!-- Quick Craft Telemetry Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs font-sans">
            <div class="p-4 rounded-2xl bg-[#F5F3EF] border border-[#EBE7DF]">
              <span class="block text-[10px] uppercase tracking-wider text-[#8A9A86] font-semibold mb-1">Origen</span>
              <p class="font-medium text-[#243026] truncate">{product.origin}</p>
            </div>
            <div class="p-4 rounded-2xl bg-[#F5F3EF] border border-[#EBE7DF]">
              <span class="block text-[10px] uppercase tracking-wider text-[#8A9A86] font-semibold mb-1">Materiales</span>
              <p class="font-medium text-[#243026] truncate" title={product.materials}>{product.materials}</p>
            </div>
            <div class="p-4 rounded-2xl bg-[#F5F3EF] border border-[#EBE7DF]">
              <span class="block text-[10px] uppercase tracking-wider text-[#8A9A86] font-semibold mb-1">Dimensiones</span>
              <p class="font-medium text-[#243026] truncate">{product.dimensions}</p>
            </div>
          </div>

          <!-- Artisanal Narrative Quote -->
          <div class="p-6 rounded-2xl bg-[#FBFBFA] border border-[#EBE7DF] text-xs text-[#4A5B48] leading-relaxed">
            <p class="italic">
              "Cada objeto se elabora con respeto minucioso al ritmo del material. Las vetas singulares y texturas naturales son el sello de autenticidad de una pieza única que madura con serenidad."
            </p>
          </div>
        </div>

        <!-- Right Column: Editorial Product Metadata & Purchasing Module -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="zen-badge text-[10px] bg-[#DCE3DA]/50 text-[#243026]">COLECCIÓN PERMANENTE</span>
              <div class="flex items-center gap-1 text-[#8A9A86] text-xs font-sans font-medium">
                <span>★ {product.rating ?? 4.9}</span>
                <span class="text-neutral-400">({product.reviewsCount ?? 28} reseñas verificadas)</span>
              </div>
            </div>

            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#243026] font-medium leading-tight mb-2">
              {product.name}
            </h1>
            <p class="font-sans text-xs sm:text-sm text-[#8A9A86] tracking-wider uppercase font-semibold mb-5">
              {product.subtitle}
            </p>

            <!-- Price & Shipping Badge -->
            <div class="flex items-baseline gap-4 pb-6 border-b border-[#EBE7DF]">
              <span class="font-serif text-3xl sm:text-4xl font-bold text-[#243026]">
                {formatPrice(product.price)}
              </span>
              <span class="text-xs font-sans text-[#4A5B48] bg-[#DCE3DA]/40 px-3 py-1 rounded-full border border-[#8A9A86]/20 font-medium">
                {product.price >= 150 ? '🌿 Envío Cortesía Incluido' : 'Envío asegurado en caja artesanal'}
              </span>
            </div>
          </div>

          <!-- Full Artisanal Description -->
          <div class="space-y-4 font-sans text-sm text-[#4A5B48] leading-relaxed">
            <p>{product.description}</p>
          </div>

          <!-- Interactive Purchasing Controls -->
          <div class="p-6 rounded-3xl bg-[#F5F3EF] border border-[#EBE7DF] space-y-4 shadow-sm">
            <!-- Quantity Selector -->
            <div class="flex items-center justify-between">
              <span class="font-sans text-xs font-semibold text-[#243026] uppercase tracking-wider">Cantidad</span>
              <div class="flex items-center gap-3 bg-white border border-[#EBE7DF] rounded-full px-3 py-1 shadow-sm">
                <button 
                  id="qty-dec-btn"
                  type="button" 
                  class="w-6 h-6 flex items-center justify-center text-sm font-bold text-[#4A5B48] hover:text-[#243026] active:scale-90"
                  aria-label="Disminuir cantidad"
                >−</button>
                <span id="qty-val" class="font-sans text-sm font-semibold min-w-[20px] text-center text-[#243026]">1</span>
                <button 
                  id="qty-inc-btn"
                  type="button" 
                  class="w-6 h-6 flex items-center justify-center text-sm font-bold text-[#4A5B48] hover:text-[#243026] active:scale-90"
                  aria-label="Aumentar cantidad"
                >+</button>
              </div>
            </div>

            <!-- Primary Add to Cart Button -->
            <button 
              id="product-add-cart-btn"
              type="button"
              class="w-full py-4 px-6 rounded-full bg-[#243026] hover:bg-[#344637] text-white font-sans text-sm font-semibold tracking-wide transition-all duration-300 hover:shadow-xl active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Añadir a la Cesta</span>
              <span>·</span>
              <span id="btn-total-display">{formatPrice(product.price)}</span>
            </button>

            <!-- 1-Click Instant Stripe Checkout Button -->
            <button 
              id="product-buy-now-btn"
              type="button"
              class="w-full py-3.5 px-6 rounded-full bg-white hover:bg-[#FBFBFA] border border-[#243026] text-[#243026] font-sans text-xs font-semibold tracking-wide transition-all hover:scale-[1.01] active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer shadow-sm"
            >
              <span>Comprar con 1-Click (Checkout Rápido)</span>
              <span>🔒</span>
            </button>
          </div>

          <!-- Trust & Guarantees Accordion/List -->
          <div class="space-y-3 pt-4 border-t border-[#EBE7DF] text-xs font-sans text-[#4A5B48]">
            <div class="flex items-start gap-3">
              <span class="text-[#8A9A86] text-sm">✓</span>
              <div>
                <strong class="text-[#243026]">Certificación Sostenible:</strong>
                <span> Packaging 100% libre de plásticos, papel kraft y relleno vegetal soluble.</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[#8A9A86] text-sm">✓</span>
              <div>
                <strong class="text-[#243026]">Garantía de Satisfacción de 30 Días:</strong>
                <span> Devolución completa sin fricciones si la pieza no armoniza con tu espacio.</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-[#8A9A86] text-sm">✓</span>
              <div>
                <strong class="text-[#243026]">Pasarela de Pago Protegida:</strong>
                <span> Encriptación de 256 bits procesada por Stripe (PCI DSS Nivel 1).</span>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- Related Objects Reel (Curated from Atelier Collection) -->
      <section class="mt-28 sm:mt-36 pt-16 border-t border-[#EBE7DF]">
        <div class="flex items-end justify-between mb-10">
          <div>
            <span class="zen-badge bg-[#F5F3EF] text-[#243026] mb-2">ARMONÍA VISUAL</span>
            <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#243026] font-medium">
              Piezas en Resonancia
            </h2>
          </div>
          <a href="/#collection" class="font-sans text-xs font-medium text-[#4A5B48] hover:text-[#243026] transition-colors">
            Ver Toda la Colección →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          {relatedProducts.map((item) => (
            <article class="bg-white rounded-3xl border border-[#EBE7DF] overflow-hidden shadow-zen-subtle hover:shadow-zen-card hover:border-[#8A9A86]/50 transition-all duration-300 flex flex-col justify-between group">
              <a href={`/producto/${item.id}`} class="block aspect-[4/3] overflow-hidden bg-[#F5F3EF] relative">
                <img 
                  src={item.image} 
                  alt={item.name} 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out filter brightness-[0.98]"
                  loading="lazy"
                />
                <div class="absolute top-4 right-4">
                  <span class="px-2.5 py-1 rounded-full bg-[#243026]/80 text-white text-[10px] font-sans font-medium backdrop-blur-md">
                    {formatPrice(item.price)}
                  </span>
                </div>
              </a>

              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[10px] font-sans text-neutral-400 uppercase tracking-wider">{item.category}</span>
                  <a href={`/producto/${item.id}`}>
                    <h3 class="font-serif text-xl font-medium text-[#243026] group-hover:text-[#4A5B48] transition-colors mt-1 mb-1.5">
                      {item.name}
                    </h3>
                  </a>
                  <p class="font-sans text-xs text-neutral-500 line-clamp-2 mb-4 leading-relaxed">{item.description}</p>
                </div>

                <div class="pt-4 border-t border-[#EBE7DF] flex items-center justify-between">
                  <span class="font-serif text-lg font-bold text-[#243026]">{formatPrice(item.price)}</span>
                  <a 
                    href={`/producto/${item.id}`}
                    class="px-4 py-2 rounded-full bg-[#F5F3EF] hover:bg-[#243026] hover:text-white text-[#243026] font-sans text-xs font-semibold transition-all"
                  >
                    Explorar Pieza
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

    </div>
  </main>

  <!-- Interactive Slide-Over Cart Drawer -->
  <CartDrawer />

  <!-- Floating Zen Dock -->
  <DockBar />
</Layout>

<script is:inline define:vars={{ productJson: JSON.stringify(product) }}>
  /**
   * Controlador del Cliente para la Ficha de Producto
   * ----------------------------------------------------------------------------
   * Maneja el estado local del selector de cantidad, el formateo de divisas y
   * el despacho de eventos hacia el bus global del carrito ('add-to-cart').
   */
  const productData = JSON.parse(productJson);
  let selectedQuantity = 1;

  // Formatea importes numéricos a divisa legible (USD por defecto)
  function formatCurrency(amount) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: productData.currency || 'USD',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(amount);
  }

  function setupProductPage() {
    // Referencias a los elementos del DOM de la ficha
    const decBtn = document.getElementById('qty-dec-btn');
    const incBtn = document.getElementById('qty-inc-btn');
    const qtyVal = document.getElementById('qty-val');
    const totalDisplay = document.getElementById('btn-total-display');
    const addCartBtn = document.getElementById('product-add-cart-btn');
    const buyNowBtn = document.getElementById('product-buy-now-btn');

    /**
     * Actualiza la cantidad seleccionada con límites de seguridad:
     * - Mínimo: 1 unidad (evita cantidades negativas o cero).
     * - Máximo: 99 unidades (evita desbordamientos lógicos).
     */
    function updateQuantity(newQty) {
      selectedQuantity = Math.max(1, Math.min(99, newQty));
      if (qtyVal) qtyVal.textContent = selectedQuantity.toString();
      if (totalDisplay) totalDisplay.textContent = formatCurrency(productData.price * selectedQuantity);
    }

    // Botones de incremento y decremento
    decBtn?.addEventListener('click', () => updateQuantity(selectedQuantity - 1));
    incBtn?.addEventListener('click', () => updateQuantity(selectedQuantity + 1));

    /**
     * Botón Principal: "Añadir a la Cesta"
     * Despacha el evento personalizado 'add-to-cart' que escucha CartDrawer.astro.
     * Incluye 'stripePriceId' para asegurar la integridad de precios en Stripe.
     */
    addCartBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('add-to-cart', {
        detail: {
          id: productData.id,
          name: productData.name,
          subtitle: productData.subtitle,
          price: productData.price,
          currency: productData.currency,
          image: productData.image,
          quantity: selectedQuantity,
          stripePriceId: productData.stripePriceId,
        }
      }));
    });

    /**
     * Botón "Comprar con 1-Click" (Checkout Rápido)
     * Añade la pieza a la cesta e inmediatamente transiciona al usuario a /checkout.
     */
    buyNowBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('add-to-cart', {
        detail: {
          id: productData.id,
          name: productData.name,
          subtitle: productData.subtitle,
          price: productData.price,
          currency: productData.currency,
          image: productData.image,
          quantity: selectedQuantity,
          stripePriceId: productData.stripePriceId,
        }
      }));
      setTimeout(() => {
        window.location.href = '/checkout';
      }, 120);
    });
  }

  // Inicialización segura según el ciclo de carga del DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProductPage);
  } else {
    setupProductPage();
  }
</script>
