---
// StickyScrollytelling.astro - Craft & Philosophy Scrollytelling (StackLab Atelier)
// Architectural Clip-Path Image Reveals: 01 Sostenibilidad -> 02 Artesanía Pura -> 03 Armonía Cotidiana
interface Phase {
  id: number;
  badge: string;
  tag: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  detailTitle: string;
  detailSpecs: { label: string; value: string }[];
  align: 'left' | 'right' | 'center';
  actionButton?: string;
  actionHref?: string;
}

const phases: Phase[] = [
  {
    id: 1,
    badge: "01 // ORIGEN",
    tag: "MATERIA PRIMA NOBLE",
    title: "Sostenibilidad en la Raíz.",
    description: "Cada pieza comienza en la tierra. Seleccionamos arcillas volcánicas recolectadas de manera responsable, maderas de bosques con certificación de reforestación activa y lino europeo sin blanqueadores químicos.",
    image: "https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?auto=format&fit=crop&w=1200&q=80",
    imageAlt: "Artesano modelando arcilla en torno tradicional",
    detailTitle: "TRAZABILIDAD ÉTICA",
    detailSpecs: [
      { label: "ARCILLA", value: "Gres Chamotado" },
      { label: "MADERA", value: "Ciprés Hinoki Certificado" },
      { label: "TINTES", value: "100% Botánicos" },
      { label: "HUELLA", value: "Neutral Clima" }
    ],
    align: "left"
  },
  {
    id: 2,
    badge: "02 // FORMA",
    tag: "MAESTRÍA MANUAL",
    title: "Artesanía Pura y Proporción.",
    description: "Nuestros artesanos dedican semanas al pulido, ensamblaje tradicional a cola de milano y horneado a alta temperatura. La mano humana deja una huella sutil que ninguna máquina puede duplicar.",
    image: "https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80",
    imageAlt: "Texturas de madera natural y acabados artesanales",
    detailTitle: "GEOMETRÍA ORGÁNICA",
    detailSpecs: [
      { label: "PROCESO", value: "Modelado Manual" },
      { label: "TÉCNICA", value: "Ensamblaje Ciego" },
      { label: "ACABADO", value: "Cera de Abeja Natural" },
      { label: "DURABILIDAD", value: "Generacional" }
    ],
    align: "right"
  },
  {
    id: 3,
    badge: "03 // ESPACIO",
    tag: "CALMA COTIDIANA",
    title: "Armonía en el Santuario.",
    description: "Diseñamos objetos no para llenar un espacio, sino para crear pausas conscientes. Una vasija, una lámpara sutil o una consola despejada transforman la habitación en un refugio de serenidad cotidiana.",
    image: "https://images.unsplash.com/photo-1598928506311-c55ded91a20c?auto=format&fit=crop&w=1200&q=80",
    imageAlt: "Espacio zen iluminado por luz natural con objetos artesanales",
    detailTitle: "PRESENCIA SERENA",
    detailSpecs: [
      { label: "PROPÓSITO", value: "Habitar con Calma" },
      { label: "ESTÉTICA", value: "Wabi-Sabi Silencioso" },
      { label: "LUMEN", value: "Cálido Natural" },
      { label: "EXPERIENCIA", value: "Tacto & Sosiego" }
    ],
    align: "center",
    actionButton: "Explorar la Colección Atelier →",
    actionHref: "#collection"
  }
];
---

<section id="philosophy" class="story-container relative bg-[#FBFBFA] border-t border-[#EBE7DF]">
  <!-- Anchor for direct navigation to craft phase -->
  <div id="craft" class="absolute top-[35%] pointer-events-none"></div>
  <!-- Sticky Viewport Visual Stage (Fixed 100dvh while scrolling) -->
  <div class="sticky-visual pointer-events-none items-start pt-20 sm:pt-24 md:pt-0 md:items-center px-4 sm:px-6">
    
    {phases.map((phase, idx) => (
      <div class={`visual-step ${idx === 0 ? 'active' : ''}`} id={`visual-${phase.id}`}>
        <div class="clip-polygon-panel w-full max-w-3xl h-[38vh] sm:h-[44vh] md:h-[65vh] rounded-[24px] bg-[#F5F3EF] border border-[#EBE7DF] overflow-hidden relative shadow-[0_25px_50px_rgba(28,31,29,0.08)] pointer-events-auto flex flex-col md:flex-row">
          
          <!-- Image Section with Subtle Ken Burns Zoom -->
          <div class="w-full md:w-3/5 h-48 md:h-full relative overflow-hidden">
            <img 
              src={phase.image} 
              alt={phase.imageAlt}
              class="w-full h-full object-cover object-center filter brightness-[0.97] contrast-[0.98]"
            />
            <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-transparent via-transparent to-[#F5F3EF]"></div>
          </div>

          <!-- Metadata & Details Column -->
          <div class="w-full md:w-2/5 p-4 sm:p-6 md:p-8 flex flex-col justify-between bg-[#F5F3EF]">
            <div>
              <div class="flex items-center justify-between border-b border-[#EBE7DF] pb-3 mb-4">
                <span class="zen-badge text-[9px] sm:text-[10px] bg-white text-[#243026]">{phase.badge}</span>
                <span class="font-sans text-[10px] sm:text-[11px] font-semibold text-[#8A9A86] tracking-wider">{phase.tag}</span>
              </div>
              <h4 class="font-serif text-lg sm:text-xl md:text-2xl font-medium text-[#243026] mb-4">
                {phase.detailTitle}
              </h4>
            </div>

            <!-- Specs Grid -->
            <div class="grid grid-cols-2 gap-2.5 my-auto">
              {phase.detailSpecs.map((spec) => (
                <div class="p-2 sm:p-2.5 rounded-xl bg-white border border-[#EBE7DF]/80">
                  <div class="font-sans text-[9px] text-neutral-400 uppercase tracking-wider">{spec.label}</div>
                  <div class="font-sans text-xs sm:text-sm font-semibold text-[#243026] mt-0.5 truncate">{spec.value}</div>
                </div>
              ))}
            </div>

            <!-- Footer Badge -->
            <div class="pt-3 border-t border-[#EBE7DF] flex justify-between items-center text-[10px] text-neutral-500 font-sans">
              <span class="flex items-center gap-1.5 text-[#4A5B48] font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-[#8A9A86]"></span>
                Atelier Handcrafted
              </span>
              <span>100% Sostenible</span>
            </div>
          </div>

        </div>
      </div>
    ))}

  </div>

  <!-- Narrative Text Stream in Scroll Flow -->
  <div class="story-text-container">
    {phases.map((phase) => (
      <div class="story-step items-end pb-24 sm:pb-28 md:items-center md:pb-0" data-step={phase.id}>
        <div class={`story-card p-6 sm:p-8 md:p-10 max-w-lg md:max-w-[520px] ${
          phase.align === 'left' ? 'md:mr-auto md:ml-[8vw]' : 
          phase.align === 'right' ? 'md:ml-auto md:mr-[8vw]' : 
          'mx-auto text-center'
        }`}>
          <div class="flex items-center justify-between mb-3 sm:mb-4">
            <span class="zen-badge text-[9px] sm:text-[10px] bg-[#EBE7DF]/60 text-[#243026]">{phase.badge}</span>
            <span class="font-sans text-xs font-semibold text-[#8A9A86] tracking-wider">{phase.tag}</span>
          </div>
          <h3 class="font-serif text-2xl sm:text-3xl md:text-4xl text-[#243026] font-medium tracking-tight mb-3 sm:mb-4">
            {phase.title}
          </h3>
          <p class="font-sans text-xs sm:text-sm text-neutral-600 leading-relaxed mb-6 font-normal">
            {phase.description}
          </p>
          {phase.actionButton && (
            <a 
              href={phase.actionHref} 
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#243026] hover:bg-[#344637] text-white font-sans text-xs font-medium tracking-wide transition-all duration-300 hover:shadow-lg hover:scale-105 active:scale-95"
            >
              <span>{phase.actionButton}</span>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initScrollytelling() {
    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.innerWidth >= 768;
    if (prefersReducedMotion || !isDesktop) return;

    const storySteps = document.querySelectorAll('.story-step');
    const visualSteps = document.querySelectorAll<HTMLElement>('.visual-step');
    if (!visualSteps.length) return;

    let currentStep = 0;

    // Set initial architectural clip-paths
    visualSteps.forEach((visual, i) => {
      if (i === 0) {
        gsap.set(visual, {
          clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)',
          opacity: 1,
          scale: 1,
          y: 0,
          zIndex: 2,
        });
      } else {
        gsap.set(visual, {
          clipPath: 'polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)',
          opacity: 0,
          scale: 0.95,
          y: 40,
          zIndex: 1,
        });
      }
    });

    function transitionToStep(targetIndex: number) {
      if (targetIndex === currentStep) return;
      const prevIndex = currentStep;
      currentStep = targetIndex;

      if (typeof window.playMechanicalClick === 'function') {
        window.playMechanicalClick(1100 + targetIndex * 150, 0.02);
      }

      const prevVisual = visualSteps[prevIndex];
      const nextVisual = visualSteps[targetIndex];

      if (prevVisual) {
        gsap.to(prevVisual, {
          clipPath: 'polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)',
          scale: 0.96,
          y: -25,
          opacity: 0,
          duration: 0.65,
          ease: 'power3.inOut',
          zIndex: 1,
        });
      }

      if (nextVisual) {
        gsap.fromTo(
          nextVisual,
          {
            clipPath: 'polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)',
            scale: 0.96,
            y: 30,
            opacity: 0,
            zIndex: 3,
          },
          {
            clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)',
            scale: 1,
            y: 0,
            opacity: 1,
            duration: 0.75,
            ease: 'power3.out',
          }
        );
      }
    }

    // ScrollTrigger for each narrative card
    storySteps.forEach((step, idx) => {
      ScrollTrigger.create({
        trigger: step,
        start: 'top 55%',
        end: 'bottom 55%',
        onEnter: () => {
          step.classList.add('in-view');
          transitionToStep(idx);
        },
        onEnterBack: () => {
          step.classList.add('in-view');
          transitionToStep(idx);
        },
        onLeave: () => {
          step.classList.remove('in-view');
        },
        onLeaveBack: () => {
          if (idx !== 0) step.classList.remove('in-view');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollytelling);
  } else {
    initScrollytelling();
  }
</script>
