---
// CustomCursor.astro - High-Precision Editorial Magnetic Cursor
// Fluid dual-ring interpolation with GSAP quickTo() for zero latency at 60-120fps.
// Automatically disabled on touch screens via pointer: fine media query.
---

<div id="custom-cursor-container" class="hidden md:block pointer-events-none fixed inset-0 z-50 overflow-hidden select-none">
  <!-- Small precise center dot -->
  <div 
    id="cursor-dot" 
    class="fixed top-0 left-0 w-2 h-2 rounded-full bg-[#243026] -translate-x-1/2 -translate-y-1/2 pointer-events-none z-50 transition-opacity duration-200 opacity-0"
  ></div>

  <!-- Smooth tracking ring with dynamic labels -->
  <div 
    id="cursor-ring" 
    class="fixed top-0 left-0 w-10 h-10 rounded-full border border-[#243026]/40 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-40 flex items-center justify-center transition-all duration-300 ease-out opacity-0 backdrop-blur-[1px]"
  >
    <span id="cursor-label" class="text-[9px] uppercase tracking-widest font-sans font-bold text-[#243026] opacity-0 transition-opacity duration-200"></span>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function initCustomCursor() {
    // Only run on desktop devices with a precision mouse
    if (!window.matchMedia('(pointer: fine)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const dot = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');
    const label = document.getElementById('cursor-label');

    if (!dot || !ring || !label) return;

    // High performance quickTo setters
    const setDotX = gsap.quickTo(dot, 'x', { duration: 0.08, ease: 'power3' });
    const setDotY = gsap.quickTo(dot, 'y', { duration: 0.08, ease: 'power3' });

    const setRingX = gsap.quickTo(ring, 'x', { duration: 0.35, ease: 'power3.out' });
    const setRingY = gsap.quickTo(ring, 'y', { duration: 0.35, ease: 'power3.out' });

    let isVisible = false;

    window.addEventListener('mousemove', (e) => {
      if (!isVisible) {
        isVisible = true;
        dot.style.opacity = '1';
        ring.style.opacity = '1';
      }

      setDotX(e.clientX);
      setDotY(e.clientY);
      setRingX(e.clientX);
      setRingY(e.clientY);
    });

    window.addEventListener('mouseleave', () => {
      isVisible = false;
      dot.style.opacity = '0';
      ring.style.opacity = '0';
    });

    // Interactive target detection
    const handleMouseOver = (e: MouseEvent) => {
      const target = (e.target as HTMLElement).closest('button, a, .product-card, input, [data-cursor]');
      if (!target) {
        // Reset to normal
        ring.className = 'fixed top-0 left-0 w-10 h-10 rounded-full border border-[#243026]/40 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-40 flex items-center justify-center transition-all duration-300 ease-out backdrop-blur-[1px]';
        label.textContent = '';
        label.style.opacity = '0';
        dot.style.transform = 'translate(-50%, -50%) scale(1)';
        return;
      }

      // Check for reel card
      if (target.classList.contains('product-card')) {
        ring.className = 'fixed top-0 left-0 w-20 h-20 rounded-full bg-[#243026]/10 border border-[#243026]/60 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-40 flex items-center justify-center transition-all duration-300 ease-out backdrop-blur-sm';
        label.textContent = 'VER';
        label.style.opacity = '1';
        dot.style.transform = 'translate(-50%, -50%) scale(0)';
      } else if (target.tagName === 'BUTTON' || target.tagName === 'A') {
        ring.className = 'fixed top-0 left-0 w-14 h-14 rounded-full bg-[#8A9A86]/20 border border-[#4A5B48] -translate-x-1/2 -translate-y-1/2 pointer-events-none z-40 flex items-center justify-center transition-all duration-300 ease-out';
        label.textContent = '';
        label.style.opacity = '0';
        dot.style.transform = 'translate(-50%, -50%) scale(1.5)';
      }
    };

    document.addEventListener('mouseover', handleMouseOver);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomCursor);
  } else {
    initCustomCursor();
  }
</script>
