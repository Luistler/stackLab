---
// Navigation.astro - Zen Luxury E-Commerce Navigation Header
---

<nav
  class="fixed top-0 left-0 w-full z-40 p-4 md:p-6 flex justify-between items-center pointer-events-none"
  aria-label="Navegación principal"
>
  <!-- Brand Badge -->
  <div class="pointer-events-auto flex items-center gap-2.5 bg-[#FBFBFA]/90 backdrop-blur-xl border border-[#EBE7DF] px-4 py-2 rounded-full shadow-[0_4px_20px_rgba(28,31,29,0.06)] hover:border-[#8A9A86]/50 transition-colors">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#8A9A86] opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-[#8A9A86]"></span>
    </span>
    <a
      href="/"
      class="font-serif tracking-widest text-sm md:text-base font-semibold text-[#1C1F1D] hover:text-[#243026] transition-colors flex items-center gap-2"
    >
      <span>STACKLAB</span>
      <span class="text-[#8A9A86] text-xs font-sans tracking-wider uppercase font-normal">
        // ATELIER
      </span>
    </a>
  </div>

  <!-- Center Navigation Anchors -->
  <div class="pointer-events-auto hidden md:flex items-center gap-6 bg-[#FBFBFA]/90 backdrop-blur-xl border border-[#EBE7DF] px-6 py-2 rounded-full text-xs uppercase tracking-widest font-sans font-medium text-[#4A5B48] shadow-[0_4px_20px_rgba(28,31,29,0.06)]">
    <a href="/#collection" class="hover:text-[#243026] transition-colors">
      Colección
    </a>
    <span class="text-[#C7C2B6]">•</span>
    <a href="/#philosophy" class="hover:text-[#243026] transition-colors">
      Filosofía
    </a>
    <span class="text-[#C7C2B6]">•</span>
    <a href="/#craft" class="hover:text-[#243026] transition-colors">
      Artesanía
    </a>
  </div>

  <!-- Right Actions: Account & Cart -->
  <div class="pointer-events-auto flex items-center gap-2 sm:gap-3">
    <!-- User Account Button -->
    <button
      id="nav-auth-btn"
      type="button"
      aria-label="Cuenta y sesión"
      class="flex items-center gap-2 bg-[#FBFBFA]/90 hover:bg-[#F5F3EF] backdrop-blur-xl border border-[#EBE7DF] hover:border-[#8A9A86] px-3.5 py-2 rounded-full text-xs font-sans font-medium text-[#243026] shadow-[0_4px_20px_rgba(28,31,29,0.06)] transition-all active:scale-95 cursor-pointer"
      title="Cuenta de usuario"
    >
      <span
        id="nav-user-avatar"
        class="w-4 h-4 rounded-full bg-[#8A9A86]/30 flex items-center justify-center text-[9px] text-[#243026] font-bold"
      >
        👤
      </span>
      <span
        id="nav-user-label"
        class="hidden sm:inline text-xs tracking-wider uppercase font-semibold"
      >
        Cuenta
      </span>
    </button>

    <!-- Cart Trigger Button -->
    <button
      id="nav-cart-btn"
      type="button"
      aria-label="Abrir cesta de compras"
      class="flex items-center gap-2.5 bg-[#FBFBFA]/90 hover:bg-[#F5F3EF] backdrop-blur-xl border border-[#EBE7DF] hover:border-[#8A9A86] px-4 py-2 rounded-full text-xs font-sans font-medium text-[#243026] shadow-[0_4px_20px_rgba(28,31,29,0.06)] transition-all active:scale-95 cursor-pointer group"
    >
      <svg
        class="w-4 h-4 text-[#4A5B48] group-hover:text-[#243026] transition-colors"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
        />
      </svg>
      <span class="hidden sm:inline text-xs tracking-wider uppercase">
        Cesta
      </span>
      <span
        id="nav-cart-count"
        class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full text-[10px] font-bold bg-[#243026] text-[#FBFBFA] transition-transform duration-300"
      >
        0
      </span>
    </button>
  </div>
</nav>

<script>
  function setupNavigation() {
    const navCartBtn = document.getElementById('nav-cart-btn');
    const navCartCount = document.getElementById('nav-cart-count');

    // Initialize count from localStorage
    try {
      const stored =
        localStorage.getItem('stacklab_atelier_cart_v1') ||
        localStorage.getItem('stacklab_cart');
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed) && navCartCount) {
          const totalItems = parsed.reduce(
            (sum: number, item: { quantity: number }) =>
              sum + (item.quantity || 0),
            0
          );
          navCartCount.textContent = totalItems.toString();
        }
      }
    } catch (e) {
      // LocalStorage unavailable
    }

    // Open auth modal on account button click
    const navAuthBtn = document.getElementById('nav-auth-btn');
    const navUserLabel = document.getElementById('nav-user-label');
    const navUserAvatar = document.getElementById('nav-user-avatar');

    if (navAuthBtn) {
      navAuthBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-auth-modal'));
      });
    }

    // React to user auth state change
    window.addEventListener('auth-state-changed', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail && detail.user && detail.user.email) {
        if (navUserLabel)
          navUserLabel.textContent = detail.user.email.split('@')[0];
        if (navUserAvatar) {
          navUserAvatar.textContent = detail.user.email[0].toUpperCase();
          navUserAvatar.className =
            'w-4 h-4 rounded-full bg-[#243026] text-[#FBFBFA] flex items-center justify-center text-[9px] font-bold';
        }
      }
    });

    // Open cart drawer on button click
    if (navCartBtn) {
      navCartBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-cart'));
      });
    }

    // Listen to reactive cart updates
    window.addEventListener('cart-updated', (e: Event) => {
      const customEvent = e as CustomEvent<{ count: number }>;
      if (navCartCount && customEvent.detail) {
        navCartCount.textContent = customEvent.detail.count.toString();
        // Micro-bounce visual feedback
        navCartCount.classList.add('scale-125', 'bg-[#8A9A86]');
        navCartCount.classList.remove('bg-[#243026]');
        setTimeout(() => {
          navCartCount.classList.remove('scale-125', 'bg-[#8A9A86]');
          navCartCount.classList.add('bg-[#243026]');
        }, 300);
      }
    });
  }

  setupNavigation();
  document.addEventListener('astro:page-load', setupNavigation);
</script>
