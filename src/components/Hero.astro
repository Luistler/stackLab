---
// Hero.astro - Serene Zen Architectural Entrance (StackLab Atelier)
// Cormorant Garamond Editorial Typography, Natural Light Imagery, and GSAP Depth Scrub
---

<header
  id="hero-container"
  class="relative w-full h-[100dvh] flex flex-col justify-between items-center text-center px-4 sm:px-6 py-12 md:py-16 overflow-hidden z-10 bg-[#FBFBFA]"
>
  <!-- Layer 0: Ambient Organic Watercolor Mist & Natural Light Bloom -->
  <div class="hero-ambient-mist absolute inset-0 pointer-events-none -z-20 overflow-hidden transform-gpu will-change-transform opacity-90">
    <div class="mist-blob-1 absolute w-[600px] h-[600px] rounded-full bg-[#DCE3DA]/50 blur-[140px] -top-24 -left-24 transform-gpu will-change-transform"></div>
    <div class="mist-blob-2 absolute w-[550px] h-[550px] rounded-full bg-[#EBE7DF]/70 blur-[130px] -bottom-24 -right-24 transform-gpu will-change-transform"></div>
    <div class="mist-blob-3 absolute w-[450px] h-[450px] rounded-full bg-[#8A9A86]/25 blur-[120px] top-1/3 right-1/3 transform-gpu will-change-transform"></div>
  </div>

  <!-- Layer 1: High-Resolution Serene Living Visual Backdrop -->
  <div class="hero-bg-visual absolute inset-0 -z-10 pointer-events-none transform-gpu will-change-transform overflow-hidden flex items-center justify-center opacity-85">
    <div class="w-full h-full relative overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=2000&q=85"
        alt="Serene Minimalist Living Atelier"
        class="hero-backdrop-img w-full h-full object-cover object-center filter brightness-[0.98] contrast-[0.96] scale-105 transform-gpu will-change-transform"
      />
      <!-- Gentle Cream Gradient Vignette to Blend Seamlessly -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#FBFBFA]/90 via-[#FBFBFA]/60 to-[#FBFBFA]"></div>
    </div>
  </div>

  <!-- Top Atelier Meta Pill -->
  <div class="hero-meta-pill pt-12 sm:pt-16 transform-gpu will-change-transform z-10 opacity-0">
    <div class="zen-badge flex items-center gap-2.5 px-4 py-1.5 shadow-sm bg-white/80 backdrop-blur-md">
      <span class="w-1.5 h-1.5 rounded-full bg-[#8A9A86] animate-pulse"></span>
      <span class="tracking-widest text-[#243026]">STACKLAB ATELIER // COLECCIÓN 2026</span>
    </div>
  </div>

  <!-- Center Editorial Headline & Subtitle -->
  <div class="max-w-4xl mx-auto my-auto px-2 z-10">
    <div class="editorial-mask mb-4 sm:mb-6 overflow-hidden">
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl lg:text-[5.5rem] tracking-tight text-[#243026] leading-[1.05] select-none">
        <span class="hero-title-line-1 block transform-gpu will-change-transform italic font-light opacity-0">
          Vivir con Intención.
        </span>
        <span class="hero-title-line-2 block mt-1 sm:mt-2 transform-gpu will-change-transform font-normal tracking-wide text-[#1C1F1D] opacity-0">
          OBJETOS PARA LA CALMA<span class="text-[#8A9A86]">.</span>
        </span>
      </h1>
    </div>

    <!-- Editorial Subtitle -->
    <p class="hero-subtitle max-w-xl mx-auto text-[#4A5B48] font-sans text-xs sm:text-sm md:text-base leading-relaxed mb-8 px-4 font-normal transform-gpu will-change-transform opacity-0">
      Una cuidada selección de mobiliario esencial, vasijas acústicas y textiles de lino orgánico diseñados para
      inspirar presencia, calidez y belleza silenciosa.
    </p>

    <!-- Action CTAs -->
    <div class="hero-cta flex flex-wrap items-center justify-center gap-4 transform-gpu will-change-transform opacity-0">
      <a
        href="#collection"
        class="px-8 py-3.5 rounded-full bg-[#243026] hover:bg-[#344637] text-white font-sans text-xs sm:text-sm font-medium tracking-wider transition-all duration-300 hover:shadow-xl hover:scale-105 active:scale-95 flex items-center gap-2"
      >
        <span>Explorar Colección</span>
        <span class="text-xs">↓</span>
      </a>
      <a
        href="#philosophy"
        class="px-7 py-3.5 rounded-full bg-white/80 hover:bg-white border border-[#EBE7DF] hover:border-[#8A9A86] text-[#243026] font-sans text-xs sm:text-sm font-medium tracking-wide transition-all duration-300 shadow-sm hover:scale-105 active:scale-95"
      >
        Filosofía de Artesanía
      </a>
    </div>
  </div>

  <!-- Bottom Scroll Cue -->
  <div class="hero-scroll-cue flex flex-col items-center gap-2 text-[#4A5B48] font-sans text-[11px] tracking-widest uppercase select-none pointer-events-none pb-4 z-10 opacity-0">
    <span class="text-[10px] tracking-[0.2em] font-medium text-neutral-500">DESCUBRE LA SERENIDAD</span>
    <div class="w-4 h-7 rounded-full border border-[#8A9A86]/40 flex justify-center pt-1.5 bg-white/40">
      <div class="w-1 h-2 rounded-full bg-[#8A9A86] animate-bounce"></div>
    </div>
  </div>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initHeroAnimation() {
    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const heroContainer = document.querySelector('#hero-container') as HTMLElement | null;
    if (!heroContainer) return;

    if (prefersReducedMotion) {
      // Graceful fallback for reduced motion: reveal instantly without motion transform
      gsap.set(
        [
          '.hero-meta-pill',
          '.hero-title-line-1',
          '.hero-title-line-2',
          '.hero-subtitle',
          '.hero-cta',
          '.hero-scroll-cue',
        ],
        { opacity: 1, y: 0, scale: 1 }
      );
      return;
    }

    // 1. Entrance Choreography Timeline
    // Staggered reveals with elegant power3.out easing and transform-gpu optimization
    const entranceTl = gsap.timeline({
      defaults: {
        ease: 'power3.out',
      },
    });

    entranceTl
      .fromTo(
        '.hero-meta-pill',
        { y: -24, opacity: 0, scale: 0.96 },
        { y: 0, opacity: 1, scale: 1, duration: 1.1, delay: 0.15 }
      )
      .fromTo(
        '.hero-title-line-1',
        { y: 46, opacity: 0, rotateX: 10 },
        { y: 0, opacity: 1, rotateX: 0, duration: 1.25 },
        '-=0.8'
      )
      .fromTo(
        '.hero-title-line-2',
        { y: 50, opacity: 0, rotateX: 10 },
        { y: 0, opacity: 1, rotateX: 0, duration: 1.3 },
        '-=0.95'
      )
      .fromTo('.hero-subtitle', { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 1.1 }, '-=0.85')
      .fromTo('.hero-cta', { y: 24, opacity: 0, scale: 0.97 }, { y: 0, opacity: 1, scale: 1, duration: 1.0 }, '-=0.75')
      .fromTo('.hero-scroll-cue', { y: 15, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9 }, '-=0.6');

    // Subtle breathing drift on ambient mist blobs
    gsap.to('.mist-blob-1', {
      x: 35,
      y: 25,
      duration: 12,
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
    });
    gsap.to('.mist-blob-2', {
      x: -30,
      y: -20,
      duration: 14,
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
    });
    gsap.to('.mist-blob-3', {
      scale: 1.15,
      duration: 10,
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
    });

    // 2. ScrollTrigger Parallax Scrub & Pinning
    // Hero Visual Backdrop + Ambient Glow Mist scrubbed synchronously
    const scrollTl = gsap.timeline({
      scrollTrigger: {
        trigger: heroContainer,
        start: 'top top',
        end: '+=100%',
        pin: true,
        scrub: 0.8,
        anticipatePin: 1,
        invalidateOnRefresh: true,
      },
    });

    scrollTl
      // Subtle parallax scrub to hero visual backdrop (scale and translate)
      .to(
        '.hero-backdrop-img',
        {
          scale: 1.18,
          yPercent: 12,
          ease: 'power1.out',
        },
        0
      )
      // Ambient glow mist expansion and opacity scrub
      .to(
        '.hero-ambient-mist',
        {
          yPercent: 20,
          opacity: 0.25,
          ease: 'power1.out',
        },
        0
      )
      .to(
        '.mist-blob-1',
        {
          scale: 1.35,
          x: -60,
          y: -40,
          ease: 'power1.out',
        },
        0
      )
      .to(
        '.mist-blob-2',
        {
          scale: 1.25,
          x: 50,
          y: 40,
          ease: 'power1.out',
        },
        0
      )
      // Editorial headline and text graceful exit drift
      .to('.hero-title-line-1', { yPercent: -35, opacity: 0.2, ease: 'power1.inOut' }, 0)
      .to('.hero-title-line-2', { yPercent: -60, opacity: 0.08, ease: 'power1.inOut' }, 0.04)
      .to('.hero-subtitle', { yPercent: -40, opacity: 0, ease: 'power1.in' }, 0.02)
      .to('.hero-meta-pill', { yPercent: -30, opacity: 0, ease: 'power1.in' }, 0)
      .to('.hero-cta', { yPercent: -20, opacity: 0, duration: 0.35, ease: 'power1.in' }, 0)
      .to('.hero-scroll-cue', { opacity: 0, duration: 0.2, ease: 'power1.in' }, 0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimation);
  } else {
    initHeroAnimation();
  }
</script>
