---
// ArtifactReel.astro - Pinned Horizontal Product Showcase Reel (StackLab Atelier)
// Showcasing Curated Zen Luxury Living Objects with Quick Add to Cart, Dynamic Counter & Tilt Parallax
import { productRepository } from '../data/repositories/product.repository';
import type { Product } from '../data/products';
import { formatPrice } from '../lib/stripe';
import { AnimatedEyeIcon, AnimatedPlusIcon } from './icons/AnimatedIcons';

const products = await productRepository.getAll();
const totalCount = products.length;
const totalCountFormatted = String(totalCount).padStart(2, '0');
---

<section
  id="collection"
  class="horizontal-reel-container relative bg-[#F5F3EF] border-t border-[#EBE7DF] z-20 overflow-hidden"
>
  <!-- Anchor alias for backwards compatibility -->
  <div id="capabilities" class="absolute -top-20"></div>

  <!-- Ambient Botanical Mist -->
  <div class="absolute w-[500px] h-[500px] rounded-full bg-[#DCE3DA]/40 blur-[140px] -top-20 -left-20 pointer-events-none transform-gpu will-change-transform"></div>
  <div class="absolute w-[500px] h-[500px] rounded-full bg-[#EAE6DF]/60 blur-[130px] -bottom-20 -right-20 pointer-events-none transform-gpu will-change-transform"></div>

  <!-- Viewport Stage -->
  <div class="reel-viewport-stage min-h-[100dvh] flex flex-col justify-between pt-8 pb-36 md:pt-10 md:pb-40 px-4 sm:px-8 lg:px-16 max-w-[1600px] mx-auto w-full relative z-10">
    <!-- Reel Header & Telemetry Bar -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-6 border-b border-[#EBE7DF]">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="zen-badge bg-white text-[#243026]">COLECCIÓN PERMANENTE</span>
          <span class="text-[11px] font-sans font-semibold text-[#8A9A86] hidden sm:inline-block">
            EDICIÓN ARTESANAL LIMITADA
          </span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#243026] tracking-tight font-medium">
          Objetos para la Serenidad<span class="text-[#8A9A86]">.</span>
        </h2>
      </div>

      <!-- Telemetry Scrubber & Slide Index Indicator -->
      <div class="flex items-center gap-6">
        <p class="font-sans text-xs text-neutral-500 max-w-sm hidden xl:block leading-relaxed">
          Cada pieza está concebida para durar generaciones, fabricada en lotes pequeños con materias primas
          sostenibles.
        </p>

        <div class="flex items-center gap-4 bg-white px-5 py-2.5 rounded-full border border-[#EBE7DF] shadow-sm font-sans text-xs">
          <!-- Slide Counter (Dynamic total based on products.length) -->
          <span class="text-neutral-500 font-medium">
            [{' '}
            <span id="reel-counter-current" class="text-[#243026] font-bold">
              01
            </span>{' '}
            / <span id="reel-counter-total">{totalCountFormatted}</span> ]
          </span>

          <!-- Smooth Gradient Scrubber Bar -->
          <div class="w-24 sm:w-36 h-1.5 bg-[#EBE7DF] rounded-full overflow-hidden">
            <div
              id="reel-progress-fill"
              class="h-full bg-gradient-to-r from-[#8A9A86] via-[#4A5B48] to-[#243026] w-full origin-left transform scale-x-0 transition-transform duration-75 rounded-full"
            ></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Horizontal Track Container (Mobile Snap Carousel + Desktop GSAP Pin) -->
    <div
      id="reel-track-wrapper"
      class="reel-track-wrapper overflow-x-auto md:overflow-visible my-auto py-6 sm:py-8 snap-x snap-mandatory md:snap-none scroll-smooth"
    >
      <div class="horizontal-track flex flex-row items-stretch gap-5 sm:gap-8 will-change-transform min-w-max md:min-w-0 px-2 md:px-0 [perspective:1000px]">
        {products.map((product: Product, idx: number) => (
          <article
            class="product-card w-[86vw] sm:w-[420px] md:w-[440px] lg:w-[480px] shrink-0 snap-center bg-white rounded-[24px] border border-[#EBE7DF] overflow-hidden shadow-[0_16px_36px_-12px_rgba(28,31,29,0.06)] hover:shadow-[0_20px_40px_-10px_rgba(36,48,38,0.10)] hover:border-[#8A9A86]/50 transition-shadow duration-300 flex flex-col justify-between group transform-gpu will-change-transform"
            data-index={idx}
          >
            <!-- Product High-Resolution Image Container (Linked to Product Page) -->
            <a
              href={`/producto/${product.id}`}
              class="product-card-media block w-full h-40 sm:h-44 lg:h-48 max-h-[25vh] overflow-hidden relative bg-[#F5F3EF] transform-gpu will-change-transform"
              aria-label={`Ver detalles de ${product.name}`}
            >
              <img
                src={product.image}
                alt={product.name}
                class="product-card-img w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out filter brightness-[0.98] transform-gpu will-change-transform scale-105"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 flex gap-2 pointer-events-none">
                <span class="zen-badge bg-white/90 backdrop-blur-md text-[9px] text-[#243026] py-0.5 px-2">
                  {String(idx + 1).padStart(2, '0')} // {product.category}
                </span>
              </div>
              <div class="absolute top-3 right-3 pointer-events-none">
                <span class="px-2.5 py-0.5 rounded-full bg-[#243026]/80 text-white text-[10px] font-sans font-medium backdrop-blur-md">
                  {formatPrice(product.price)}
                </span>
              </div>
            </a>

            <!-- Product Meta & Actions -->
            <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-1 text-[11px] font-sans text-neutral-400">
                  <span>{product.origin}</span>
                  <span class="text-[#8A9A86] font-medium">
                    ★ {product.rating} ({product.reviewsCount})
                  </span>
                </div>

                <a href={`/producto/${product.id}`} class="block group/title">
                  <h3 class="font-serif text-lg sm:text-xl font-medium text-[#243026] group-hover/title:text-[#4A5B48] transition-colors leading-snug mb-1">
                    {product.name}
                  </h3>
                </a>

                <p class="font-sans text-xs text-neutral-600 leading-relaxed mb-2.5 line-clamp-2">
                  {product.description}
                </p>

                <!-- Materials & Dimensions Tags -->
                <div class="flex flex-wrap gap-1.5 text-[10px] font-sans text-neutral-600 mb-3">
                  <span class="px-2 py-0.5 rounded-lg bg-[#F5F3EF] border border-[#EBE7DF] truncate max-w-[200px]">
                    {product.materials}
                  </span>
                  <span class="px-2 py-0.5 rounded-lg bg-[#F5F3EF] border border-[#EBE7DF]">{product.dimensions}</span>
                </div>
              </div>

              <!-- Action Bar -->
              <div class="pt-2.5 border-t border-[#EBE7DF] flex items-center justify-between gap-3">
                <div>
                  <div class="font-sans text-[9px] text-neutral-400 uppercase tracking-wider">Precio</div>
                  <div class="font-serif text-lg sm:text-xl font-bold text-[#243026]">{formatPrice(product.price)}</div>
                </div>

                <div class="flex items-center gap-2 sm:gap-3">
                  <button
                    type="button"
                    data-product={JSON.stringify(product)}
                    class="btn-inspect px-3.5 py-2 rounded-full border border-[#EBE7DF] hover:border-[#243026] text-xs font-sans font-medium text-[#4A5B48] hover:text-[#243026] transition-colors cursor-pointer bg-white/70 shadow-sm flex items-center gap-1.5"
                    title="Inspección rápida"
                  >
                    <AnimatedEyeIcon client:only="react" size={13} color="currentColor" />
                    <span>Ver</span>
                  </button>
                  <button
                    type="button"
                    data-product={JSON.stringify(product)}
                    class="btn-add-cart px-4 sm:px-5 py-2 rounded-full bg-[#243026] hover:bg-[#344637] text-white font-sans text-xs font-semibold tracking-wide transition-all hover:scale-105 active:scale-95 shadow-md flex items-center gap-1.5 cursor-pointer"
                  >
                    <span>Añadir</span>
                    <AnimatedPlusIcon client:only="react" size={12} color="#FBFBFA" />
                  </button>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Bottom Navigation Hint Bar (Subtle & elevated for dock clearance) -->
    <div class="hidden md:flex justify-between items-center text-[11px] font-sans text-neutral-500 pt-3 border-t border-[#EBE7DF] mb-2">
      <span class="flex items-center gap-2 text-[#4A5B48] font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-[#8A9A86] animate-pulse"></span>
        <span>ATELIER DISPONIBLE // ENVÍO INTERNACIONAL ASEGURADO</span>
      </span>
      <div class="flex items-center gap-4">
        <span class="hidden lg:inline-block">DESLIZA O USA FLECHAS TECLADO</span>
        <span class="text-neutral-300">|</span>
        <span class="text-[#243026] font-semibold">
          {totalCount} / {totalCount} PIEZAS EN CATÁLOGO
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initArtifactReel() {
    gsap.registerPlugin(ScrollTrigger);

    const reelSection = document.querySelector('#collection') as HTMLElement | null;
    const reelTrack = document.querySelector('.horizontal-track') as HTMLElement | null;
    const progressFill = document.querySelector('#reel-progress-fill') as HTMLElement | null;
    const counterCurrent = document.querySelector('#reel-counter-current') as HTMLElement | null;
    const reelWrapper = document.querySelector('#reel-track-wrapper') as HTMLElement | null;
    const productCards = document.querySelectorAll<HTMLElement>('.product-card');

    if (!reelSection || !reelTrack) return;

    const totalSlides = productCards.length || 1;

    // Attach "Add to Cart" button listeners
    document.querySelectorAll('.btn-add-cart').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const dataRaw = target.getAttribute('data-product');
        if (!dataRaw) return;
        try {
          const product = JSON.parse(dataRaw);
          window.dispatchEvent(
            new CustomEvent('add-to-cart', {
              detail: {
                id: product.id,
                name: product.name,
                subtitle: product.subtitle,
                price: product.price,
                currency: product.currency,
                image: product.image,
                quantity: 1,
                stripePriceId: product.stripePriceId,
              },
            })
          );
        } catch (err) {}
      });
    });

    // Attach "Quick Inspect" modal trigger listeners
    document.querySelectorAll('.btn-inspect').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const dataRaw = target.getAttribute('data-product');
        if (!dataRaw) return;
        try {
          const product = JSON.parse(dataRaw);
          window.dispatchEvent(
            new CustomEvent('open-quick-inspect', {
              detail: product,
            })
          );
        } catch (err) {}
      });
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.innerWidth >= 768;

    // Mobile snap swipe listener
    if (!isDesktop && reelWrapper) {
      const updateMobileProgress = () => {
        const maxScroll = reelWrapper.scrollWidth - reelWrapper.clientWidth;
        if (maxScroll <= 0) return;
        const progress = Math.max(0, Math.min(1, reelWrapper.scrollLeft / maxScroll));
        if (progressFill) {
          progressFill.style.transform = `scaleX(${progress})`;
        }
        if (counterCurrent) {
          const slideIndex = Math.min(totalSlides, Math.max(1, Math.round(progress * (totalSlides - 1)) + 1));
          counterCurrent.textContent = String(slideIndex).padStart(2, '0');
        }
      };

      reelWrapper.addEventListener('scroll', updateMobileProgress, {
        passive: true,
      });
      updateMobileProgress();
    }

    // Desktop GSAP Pin, Smooth Horizontal Scrub, and Micro-Interaction Tilt
    if (!prefersReducedMotion && isDesktop) {
      const getScrollDistance = () => {
        return reelTrack.scrollWidth - window.innerWidth + 140;
      };

      // 1. Horizontal Scroll Pinning with Lenis + ScrollTrigger
      const reelTimeline = gsap.timeline({
        scrollTrigger: {
          id: 'collection-trigger',
          trigger: reelSection,
          pin: true,
          scrub: 1.2, // Smooth scrub integration with Lenis
          start: 'top top',
          end: () => `+=${getScrollDistance()}`,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          onUpdate: (self) => {
            if (progressFill) {
              progressFill.style.transform = `scaleX(${self.progress})`;
            }
            if (counterCurrent) {
              const slideIndex = Math.min(
                totalSlides,
                Math.max(1, Math.floor(self.progress * (totalSlides - 0.05)) + 1)
              );
              counterCurrent.textContent = String(slideIndex).padStart(2, '0');
            }
          },
        },
      });

      // Linear translation ensures 1:1 scroll alignment
      reelTimeline.to(reelTrack, {
        x: () => -getScrollDistance(),
        ease: 'none',
      });

      // Subtle horizontal parallax on inner card images during track movement
      const cardImages = document.querySelectorAll<HTMLElement>('.product-card-img');
      cardImages.forEach((img) => {
        reelTimeline.fromTo(img, { xPercent: 8 }, { xPercent: -8, ease: 'none' }, 0);
      });

      // 2. Desktop Micro-Interaction: 3D Subtle Tilt & Image Parallax using gsap.quickTo
      productCards.forEach((card) => {
        const img = card.querySelector<HTMLElement>('.product-card-img');

        // Prepare high-performance quickTo setters for 60 FPS transform-gpu
        const setCardRotateX = gsap.quickTo(card, 'rotationX', {
          duration: 0.45,
          ease: 'power3.out',
        });
        const setCardRotateY = gsap.quickTo(card, 'rotationY', {
          duration: 0.45,
          ease: 'power3.out',
        });
        const setCardZ = gsap.quickTo(card, 'z', {
          duration: 0.45,
          ease: 'power3.out',
        });

        const setImgX = img ? gsap.quickTo(img, 'x', { duration: 0.4, ease: 'power3.out' }) : null;
        const setImgY = img ? gsap.quickTo(img, 'y', { duration: 0.4, ease: 'power3.out' }) : null;

        let rect: DOMRect | null = null;

        const onMouseEnter = () => {
          rect = card.getBoundingClientRect();
          setCardZ(12);
        };

        const onMouseMove = (e: MouseEvent) => {
          if (!rect) rect = card.getBoundingClientRect();
          const cardWidth = rect.width;
          const cardHeight = rect.height;

          const mouseX = e.clientX - rect.left;
          const mouseY = e.clientY - rect.top;

          // Normalized offset -1 to 1
          const xPercent = (mouseX / cardWidth - 0.5) * 2;
          const yPercent = (mouseY / cardHeight - 0.5) * 2;

          // Very subtle calm 3D tilt: max 1.5 deg rotation (smooth and grounded)
          setCardRotateX(-yPercent * 1.5);
          setCardRotateY(xPercent * 1.8);

          // Subtle internal image counter-parallax
          if (setImgX && setImgY) {
            setImgX(xPercent * 3);
            setImgY(yPercent * 2);
          }
        };

        const onMouseLeave = () => {
          rect = null;
          setCardRotateX(0);
          setCardRotateY(0);
          setCardZ(0);
          if (setImgX && setImgY) {
            setImgX(0);
            setImgY(0);
          }
        };

        card.addEventListener('mouseenter', onMouseEnter, { passive: true });
        card.addEventListener('mousemove', onMouseMove, { passive: true });
        card.addEventListener('mouseleave', onMouseLeave, { passive: true });
      });

      // Keyboard navigation with Arrow Left / Arrow Right
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        const cartActive = document.querySelector('.cart-overlay.active');
        if (cartActive) return;

        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const st =
            ScrollTrigger.getById('collection-trigger') ||
            ScrollTrigger.getAll().find((s) => s.trigger === reelSection);
          if (st) {
            const stepDelta = 1 / Math.max(1, totalSlides - 1);
            let targetProgress = st.progress + (e.key === 'ArrowRight' ? stepDelta : -stepDelta);
            targetProgress = Math.max(0, Math.min(1, targetProgress));
            if (window.__lenis) {
              const targetScroll = st.start + targetProgress * (st.end - st.start);
              window.__lenis.scrollTo(targetScroll);
            }
          }
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArtifactReel);
  } else {
    initArtifactReel();
  }
</script>
