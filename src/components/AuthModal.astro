---
// AuthModal.astro - Zen Luxury Atelier Account Modal
// Seamless account login / registration via Supabase Auth
---

<aside
  id="auth-modal"
  class="fixed inset-0 z-50 bg-[#1C1F1D]/50 backdrop-blur-md flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="auth-modal-title"
>
  <div
    id="auth-modal-panel"
    class="relative w-full max-w-md bg-[#FBFBFA] rounded-3xl border border-[#EBE7DF] shadow-2xl overflow-hidden p-6 sm:p-8 transform scale-95 transition-all duration-300 ease-out"
  >
    <!-- Close Button -->
    <button
      id="auth-close-btn"
      type="button"
      aria-label="Cerrar modal de autenticación"
      class="absolute top-5 right-5 w-8 h-8 rounded-full bg-white border border-[#EBE7DF] hover:border-[#243026] text-[#1C1F1D] flex items-center justify-center text-xs transition-transform hover:scale-105 active:scale-95 cursor-pointer shadow-sm"
    >
      ✕
    </button>

    <!-- Header -->
    <div class="mb-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#DCE3DA]/50 border border-[#DCE3DA] text-[10px] font-sans font-semibold tracking-wider text-[#243026] uppercase mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#8A9A86] animate-pulse"></span>
        Cuenta Personal Atelier
      </div>
      <h3 id="auth-modal-title" class="font-serif text-2xl sm:text-3xl text-[#243026] font-medium tracking-tight">
        Bienvenido al Atelier
      </h3>
      <p class="font-sans text-xs text-[#4A5B48] mt-1">
        Inicia sesión para rastrear órdenes, envíos y piezas guardadas.
      </p>
    </div>

    <!-- Mode Selector Tabs: Iniciar Sesión vs Registro -->
    <div class="flex rounded-full bg-[#F5F3EF] p-1 border border-[#EBE7DF] mb-6 text-xs font-sans">
      <button
        id="tab-auth-login"
        type="button"
        class="flex-1 py-1.5 rounded-full font-medium transition-all bg-white text-[#243026] shadow-sm cursor-pointer"
      >
        Iniciar Sesión
      </button>
      <button
        id="tab-auth-register"
        type="button"
        class="flex-1 py-1.5 rounded-full font-medium text-[#4A5B48] hover:text-[#243026] transition-all cursor-pointer"
      >
        Crear Cuenta
      </button>
    </div>

    <!-- Login / Register Form -->
    <form id="auth-login-form" class="space-y-4">
      <div>
        <label
          for="auth-email"
          class="block font-sans text-[11px] uppercase tracking-wider font-semibold text-[#243026] mb-1.5"
        >
          Correo Electrónico
        </label>
        <input
          id="auth-email"
          type="email"
          required
          placeholder="tu@correo.com"
          class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#EBE7DF] text-xs font-sans text-[#1C1F1D] focus:outline-none focus:border-[#4A5B48] transition-colors"
        />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label
            for="auth-password"
            class="block font-sans text-[11px] uppercase tracking-wider font-semibold text-[#243026]"
          >
            Contraseña
          </label>
          <button
            id="auth-magic-toggle"
            type="button"
            class="text-[10px] text-[#4A5B48] hover:text-[#243026] underline cursor-pointer"
          >
            O usar Enlace Mágico
          </button>
        </div>
        <input
          id="auth-password"
          type="password"
          placeholder="••••••••"
          class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#EBE7DF] text-xs font-sans text-[#1C1F1D] focus:outline-none focus:border-[#4A5B48] transition-colors"
        />
      </div>

      <button
        id="auth-submit-btn"
        type="submit"
        class="w-full py-3 rounded-full bg-[#243026] hover:bg-[#1C1F1D] text-[#FBFBFA] font-sans text-xs uppercase tracking-widest font-semibold transition-all hover:scale-[1.02] active:scale-95 shadow-md flex items-center justify-center gap-2 cursor-pointer mt-2"
      >
        <span id="auth-submit-label">Iniciar Sesión</span>
        <span class="text-[10px]">→</span>
      </button>

      <div id="auth-status-msg" class="hidden text-[11px] font-sans text-center py-2 px-3 rounded-lg leading-relaxed"></div>
    </form>

    <!-- Active User State (When logged in) -->
    <div id="auth-logged-in-panel" class="hidden space-y-4 text-center py-2">
      <div class="w-14 h-14 rounded-full bg-[#DCE3DA] text-[#243026] flex items-center justify-center font-serif text-xl font-bold mx-auto shadow-inner">
        <span id="user-avatar-initial">L</span>
      </div>
      <div>
        <h4 id="user-email-display" class="font-serif text-lg text-[#243026] font-medium"></h4>
        <span class="text-[11px] text-[#8A9A86] font-sans">Sesión activa Atelier</span>
      </div>
      <button
        id="auth-logout-btn"
        type="button"
        class="px-6 py-2 rounded-full border border-[#EBE7DF] hover:border-red-400 text-xs font-sans text-neutral-600 hover:text-red-600 transition-colors cursor-pointer"
      >
        Cerrar Sesión
      </button>
    </div>
  </div>
</aside>

<script>
  import { getSupabaseClient } from '../lib/supabase';
  import { soundEngine } from '../scripts/sound-engine';

  function initAuthModal() {
    const modal = document.getElementById('auth-modal');
    const panel = document.getElementById('auth-modal-panel');
    const closeBtn = document.getElementById('auth-close-btn');
    const tabLogin = document.getElementById('tab-auth-login');
    const tabRegister = document.getElementById('tab-auth-register');
    const loginForm = document.getElementById('auth-login-form');
    const loggedInPanel = document.getElementById('auth-logged-in-panel');
    const logoutBtn = document.getElementById('auth-logout-btn');
    const submitBtn = document.getElementById('auth-submit-btn');
    const submitLabel = document.getElementById('auth-submit-label');
    const statusMsg = document.getElementById('auth-status-msg');
    const passInput = document.getElementById('auth-password') as HTMLInputElement;
    const magicToggle = document.getElementById('auth-magic-toggle');

    if (!modal || !panel || !closeBtn) return;

    let isRegisterMode = false;
    let isMagicLinkMode = false;

    // Mode Switch: Iniciar Sesión vs Crear Cuenta
    tabLogin?.addEventListener('click', () => {
      isRegisterMode = false;
      tabLogin.classList.add('bg-white', 'text-[#243026]', 'shadow-sm');
      tabLogin.classList.remove('text-[#4A5B48]');
      tabRegister?.classList.remove('bg-white', 'text-[#243026]', 'shadow-sm');
      tabRegister?.classList.add('text-[#4A5B48]');
      if (submitLabel) submitLabel.textContent = isMagicLinkMode ? 'Enviar Enlace Mágico' : 'Iniciar Sesión';
      if (statusMsg) statusMsg.classList.add('hidden');
    });

    tabRegister?.addEventListener('click', () => {
      isRegisterMode = true;
      tabRegister.classList.add('bg-white', 'text-[#243026]', 'shadow-sm');
      tabRegister.classList.remove('text-[#4A5B48]');
      tabLogin?.classList.remove('bg-white', 'text-[#243026]', 'shadow-sm');
      tabLogin?.classList.add('text-[#4A5B48]');
      if (submitLabel) submitLabel.textContent = 'Crear Cuenta';
      if (statusMsg) statusMsg.classList.add('hidden');
    });

    // Magic link toggle
    magicToggle?.addEventListener('click', () => {
      isMagicLinkMode = !isMagicLinkMode;
      if (isMagicLinkMode) {
        if (passInput) {
          passInput.disabled = true;
          passInput.placeholder = '(No requerida para Enlace Mágico)';
          passInput.value = '';
        }
        if (magicToggle) magicToggle.textContent = 'Usar contraseña normal';
        if (submitLabel) submitLabel.textContent = 'Enviar Enlace Mágico';
      } else {
        if (passInput) {
          passInput.disabled = false;
          passInput.placeholder = '••••••••';
        }
        if (magicToggle) magicToggle.textContent = 'O usar Enlace Mágico';
        if (submitLabel) submitLabel.textContent = isRegisterMode ? 'Crear Cuenta' : 'Iniciar Sesión';
      }
    });

    const checkSession = async () => {
      try {
        const client = getSupabaseClient();
        const {
          data: { session },
        } = await client.auth.getSession();
        if (session && session.user) {
          loginForm?.classList.add('hidden');
          document.querySelector('#auth-modal .flex.rounded-full')?.classList.add('hidden');
          loggedInPanel?.classList.remove('hidden');
          const emailDisp = document.getElementById('user-email-display');
          const initial = document.getElementById('user-avatar-initial');
          if (emailDisp) emailDisp.textContent = session.user.email || '';
          if (initial && session.user.email) initial.textContent = session.user.email[0].toUpperCase();
          window.dispatchEvent(
            new CustomEvent('auth-state-changed', {
              detail: { user: session.user },
            })
          );
        }
      } catch (e) {}
    };

    checkSession();

    // Open / Close modal
    window.addEventListener('open-auth-modal', () => {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('scale-95');
      panel.classList.add('scale-100');
      soundEngine.playChime();
      if (window.__lenis) window.__lenis.stop();
    });

    const closeModal = () => {
      modal.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('scale-100');
      panel.classList.add('scale-95');
      soundEngine.playTap(500, 0.03);
      if (window.__lenis) window.__lenis.start();
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) closeModal();
    });

    // Form submit
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('auth-email') as HTMLInputElement)?.value.trim();
      const pass = passInput?.value.trim();

      if (!email) return;
      const client = getSupabaseClient();

      if (submitLabel) submitLabel.textContent = 'Procesando...';
      if (statusMsg) statusMsg.classList.add('hidden');

      try {
        if (isMagicLinkMode) {
          const { error } = await client.auth.signInWithOtp({ email });
          if (error) throw error;
          if (statusMsg) {
            statusMsg.textContent = '✉ Enlace de acceso enviado a tu correo.';
            statusMsg.className = 'text-[11px] font-sans text-center py-2 px-3 text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-lg';
            statusMsg.classList.remove('hidden');
          }
        } else if (isRegisterMode) {
          if (!pass) {
            throw new Error('Por favor ingresa una contraseña para tu cuenta.');
          }
          const { data, error } = await client.auth.signUp({
            email,
            password: pass,
          });
          if (error) throw error;
          if (statusMsg) {
            statusMsg.textContent = '✓ Cuenta creada con éxito. Revisa tu correo o inicia sesión.';
            statusMsg.className = 'text-[11px] font-sans text-center py-2 px-3 text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-lg';
            statusMsg.classList.remove('hidden');
          }
        } else {
          // Login
          if (!pass) {
            throw new Error('Por favor ingresa tu contraseña o usa Enlace Mágico.');
          }
          const { data, error } = await client.auth.signInWithPassword({
            email,
            password: pass,
          });
          if (error) throw error;
          if (statusMsg) {
            statusMsg.textContent = '✓ Sesión iniciada con éxito.';
            statusMsg.className = 'text-[11px] font-sans text-center py-2 px-3 text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-lg';
            statusMsg.classList.remove('hidden');
          }
          setTimeout(() => {
            checkSession();
            closeModal();
          }, 800);
        }
      } catch (err: any) {
        if (statusMsg) {
          statusMsg.textContent = err.message || 'Error al autenticar.';
          statusMsg.className = 'text-[11px] font-sans text-center py-2 px-3 text-amber-900 bg-amber-50 border border-amber-200 rounded-lg';
          statusMsg.classList.remove('hidden');
        }
      } finally {
        if (submitLabel) {
          if (isMagicLinkMode) submitLabel.textContent = 'Enviar Enlace Mágico';
          else if (isRegisterMode) submitLabel.textContent = 'Crear Cuenta';
          else submitLabel.textContent = 'Iniciar Sesión';
        }
      }
    });

    logoutBtn?.addEventListener('click', async () => {
      try {
        const client = getSupabaseClient();
        await client.auth.signOut();
        loggedInPanel?.classList.add('hidden');
        loginForm?.classList.remove('hidden');
        document.querySelector('#auth-modal .flex.rounded-full')?.classList.remove('hidden');
        window.location.reload();
      } catch (e) {}
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuthModal);
  } else {
    initAuthModal();
  }
</script>
